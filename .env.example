# GEMINI_API_KEY: Required for Gemini AI auto-reply and address parsing.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: Local web server port.
PORT="3000"

# FACEBOOK_GRAPH_API_VERSION: Keep this aligned with Meta's current Graph API version.
FACEBOOK_GRAPH_API_VERSION="v26.0"

# Facebook Messenger webhook settings for production hosting.
FACEBOOK_VERIFY_TOKEN="my_fb_verify_token_123"
FACEBOOK_PAGE_ID="100840554970631"
FACEBOOK_PAGE_ACCESS_TOKEN="EAAb..."

# Optional: Vercel Blob persistent JSON database.
# Vercel creates BLOB_READ_WRITE_TOKEN automatically when a Blob store is linked.
BLOB_DB_PATH="data/db.json"

# Optional: enable admin login protection in production.
ADMIN_PASSWORD="change-me"
ADMIN_SESSION_SECRET="change-me-to-a-long-random-secret"
